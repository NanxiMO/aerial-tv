<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere, except Apple's aerial films: the screensaver falls back to HTTP for them on
     TVs that do not trust Apple's root certificate (see AerialSaver). -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">sylvan.apple.com</domain>
    </domain-config>
</network-security-config>
